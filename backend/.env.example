# ============================================================
# Database PostgreSQL
# ============================================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=fikom
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# SSL: set true kalau koneksi ke DB pakai SSL (mis. cloud DB).
# Untuk PostgreSQL lokal, biarkan false.
DATABASE_SSL=false

# (Opsional) Kalau DATABASE_URL di-set, akan dipakai dan
# field di atas diabaikan. Berguna untuk Heroku/Railway/Render
# yang inject DATABASE_URL otomatis.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ============================================================
# Auth
# ============================================================
JWT_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter
JWT_EXPIRES_IN=12h

# Bcrypt cost (10-12 untuk production)
BCRYPT_ROUNDS=12

# ============================================================
# Server
# ============================================================
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ============================================================
# Superadmin Seed
# Hanya dipakai oleh `npm run seed:superadmin`.
# Jalankan SEKALI, lalu KOSONGKAN/HAPUS SUPERADMIN_PASSWORD
# supaya kredensial tidak nyangkut di file.
# ============================================================
SUPERADMIN_FULL_NAME=Super Administrator
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=ChangeMe!2026
SUPERADMIN_EMAIL=
